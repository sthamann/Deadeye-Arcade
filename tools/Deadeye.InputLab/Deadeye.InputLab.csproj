<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Version>0.3.66</Version>
    <Product>Deadeye Input Lab</Product>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>../../src/Reaper.Windows/app.manifest</ApplicationManifest>
    <HIDMaestroDir Condition="'$(HIDMaestroDir)' == ''">../../work/input-lab-sdk</HIDMaestroDir>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <ProjectReference Include="../../src/Reaper.Windows/Reaper.Windows.csproj" />
    <Reference Include="HIDMaestro.Core"><HintPath>$(HIDMaestroDir)/HIDMaestro.Core.dll</HintPath></Reference>
    <Reference Include="Microsoft.Windows.SDK.NET"><HintPath>$(HIDMaestroDir)/Microsoft.Windows.SDK.NET.dll</HintPath></Reference>
    <Reference Include="WinRT.Runtime"><HintPath>$(HIDMaestroDir)/WinRT.Runtime.dll</HintPath></Reference>
  </ItemGroup>
</Project>
